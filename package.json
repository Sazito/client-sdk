{
  "name": "@sazito/client-sdk",
  "version": "1.2.20",
  "packageManager": "pnpm@10.28.2",
  "description": "Official JavaScript/TypeScript SDK for Sazito e-commerce platform - Client Edition",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c",
    "dev": "rollup -c -w",
    "visual:apis": "pnpm run build && node scripts/visual-docs-server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "validate": "pnpm run typecheck && pnpm run lint",
    "prepublishOnly": "pnpm run build && pnpm run validate",
    "docs:install": "pnpm --dir docs install",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:start": "pnpm --dir docs run start",
    "docs:typecheck": "pnpm --dir docs run types:check",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "release:sdk": "node scripts/release.mjs sdk",
    "release:checkout": "node scripts/release.mjs checkout",
    "release:all": "node scripts/release.mjs all"
  },
  "keywords": [
    "sazito",
    "ecommerce",
    "sdk",
    "api",
    "client",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "Sazito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sazito/client-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sazito/client-sdk/issues"
  },
  "homepage": "https://github.com/sazito/client-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2"
  }
}
