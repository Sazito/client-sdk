# Publish scope is primarily controlled by package.json "files".
# This file is a fallback safety net.

# Source and docs
src/
examples/
docs/
scripts/
/scripts/**

# Tests and coverage
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
.nyc_output/

# Build and local artifacts
node_modules/
dist/
dist/**/*.map
.next/
out/
.source/
*.tsbuildinfo
*.log
*.tmp
*.temp
*.tgz
.DS_Store

# Package manager caches
.yarn/
.npm-cache/
.npm/
.pnpm-store/

# Tooling and metadata
tsconfig.json
rollup.config.js
.editorconfig
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/
*.swp
*.swo
*~
yarn.lock
package-lock.json
pnpm-lock.yaml
.travis.yml
.circleci/
.gitlab-ci.yml
